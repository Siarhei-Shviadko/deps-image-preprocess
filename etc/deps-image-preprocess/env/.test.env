DEFAULT_PREPROCESSORS=["rotation","orientation"]

LOG_LEVEL=info

FILE_STORAGE_URL=http://file-storage-nginx:8000/api/storage/v1/file
UNIFIER_URL=http://deps-unifier:8000/api/unifier/v1

# Auth
AUTH_ENABLED=false
AUTH_VERIFY_SSL=false

# Possible values: none, organisation
ACCESS_MODE=none
DEFAULT_ORGANISATION=deps-users
ADMINS_GROUP=deps-admins

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@test-rabbitmq:5672/test_deps

# Kafka
KAFKA_GROUP_ID=image-preprocess
